// ─────────────────────────────────────────────────────────────────
// TOQUE DE COR – PRISMA SCHEMA COMPLETO
// Banco: PostgreSQL 16 + pgvector (para RAG/embeddings)
// ─────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp"), pgTrgm(map: "pg_trgm")]
}

// ─── TENANT (Empresa/Rede) ────────────────────────────────────────
model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  cnpj        String?  @unique
  logo        String?
  primaryColor String? @default("#E63946")
  plan        PlanType @default(STARTER)
  isActive    Boolean  @default(true)
  maxStores   Int      @default(5)
  maxUsers    Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stores       Store[]
  users        User[]
  products     Product[]
  categories   Category[]
  brands       Brand[]
  customers    Customer[]
  leads        Lead[]
  conversations Conversation[]
  aiConfigs    AIConfig[]
  prompts      Prompt[]

  @@map("tenants")
}

// ─── LOJA ─────────────────────────────────────────────────────────
model Store {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  code        String  // código da loja (ex: "SP01")
  cnpj        String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  lat         Float?
  lng         Float?
  isActive    Boolean @default(true)
  isOpen      Boolean @default(true)
  openHours   Json?   // { seg: "08:00-18:00", ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users         User[]
  conversations Conversation[]
  leads         Lead[]
  whatsappInstances WhatsAppInstance[]

  @@unique([tenantId, code])
  @@map("stores")
}

// ─── USUÁRIO (Admin/Vendedor/Gerente) ────────────────────────────
model User {
  id           String   @id @default(uuid())
  tenantId     String
  storeId      String?
  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole @default(SELLER)
  avatar       String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store?         @relation(fields: [storeId], references: [id])
  assignedConversations Conversation[] @relation("AssignedSeller")
  messages            Message[]
  refreshTokens       RefreshToken[]

  @@unique([tenantId, email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── CLIENTE ──────────────────────────────────────────────────────
model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  name         String?
  phone        String
  email        String?
  cpf          String?
  city         String?
  state        String?
  profileData  Json?    // dados adicionais capturados na conversa
  tags         String[] @default([])
  totalOrders  Int      @default(0)
  totalSpent   Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  leads         Lead[]

  @@unique([tenantId, phone])
  @@map("customers")
}

// ─── CONVERSA ─────────────────────────────────────────────────────
model Conversation {
  id              String             @id @default(uuid())
  tenantId        String
  storeId         String?
  customerId      String?
  assignedUserId  String?
  channel         ChannelType        @default(WHATSAPP)
  status          ConversationStatus @default(BOT)
  whatsappPhone   String?
  whatsappMsgId   String?
  sessionData     Json?              // dados coletados pelo bot (ambiente, metragem, etc.)
  summary         String?            // resumo gerado pela IA para o vendedor
  qualificationScore Int?            // 0-100: score de qualificação do lead
  source          String?            // de onde veio (whatsapp, website, etc.)
  closedAt        DateTime?
  transferredAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store?    @relation(fields: [storeId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  assignedUser User?     @relation("AssignedSeller", fields: [assignedUserId], references: [id])
  messages     Message[]
  leads        Lead[]
  recommendedProducts ConversationProduct[]

  @@map("conversations")
}

// ─── MENSAGEM ─────────────────────────────────────────────────────
model Message {
  id             String      @id @default(uuid())
  conversationId String
  userId         String?     // se mensagem enviada por usuário/vendedor
  role           MessageRole
  content        String
  contentType    ContentType @default(TEXT)
  mediaUrl       String?
  metadata       Json?       // dados extras (botões, listas, etc.)
  isFromBot      Boolean     @default(false)
  tokensUsed     Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@map("messages")
}

// ─── LEAD ──────────────────────────────────────────────────────────
model Lead {
  id             String     @id @default(uuid())
  tenantId       String
  storeId        String?
  conversationId String?
  customerId     String?
  name           String?
  phone          String
  email          String?
  status         LeadStatus @default(NEW)
  source         String?
  projectType    String?    // tipo de projeto (casa, apartamento, comercial, etc.)
  environment    String?    // tipo de ambiente (sala, quarto, fachada, etc.)
  surface        String?    // tipo de superfície (parede, madeira, metal, etc.)
  area           Float?     // metragem em m²
  budget         Float?     // orçamento estimado
  estimatedValue Float?     // valor estimado do pedido
  notes          String?
  assignedUserId String?
  closedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store?        @relation(fields: [storeId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])

  @@map("leads")
}

// ─── PRODUTO ──────────────────────────────────────────────────────
model Product {
  id              String   @id @default(uuid())
  tenantId        String
  categoryId      String
  brandId         String
  sku             String
  name            String
  description     String?
  technicalData   String?  // ficha técnica detalhada
  application     String?  // como aplicar
  surfaces        String[] // superfícies compatíveis
  environments    String[] // ambientes compatíveis (interno, externo)
  finishes        String[] // acabamentos (fosco, acetinado, brilhante)
  colors          Json?    // paleta de cores disponíveis
  coverage        Float?   // rendimento em m²/L
  dryTime         String?  // tempo de secagem
  coats           Int?     // número de demãos
  dilution        String?  // diluição recomendada
  price           Float
  priceUnit       String   @default("L")  // L, galão, kg, m²
  availableSizes  Json?    // [{ size: "3.6L", price: 89.90 }, ...]
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  stock           Int      @default(0)
  minStock        Int      @default(5)
  tags            String[] @default([])
  embedding       Unsupported("vector(1536)")? // para RAG
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category            Category             @relation(fields: [categoryId], references: [id])
  brand               Brand                @relation(fields: [brandId], references: [id])
  images              ProductImage[]
  conversationProducts ConversationProduct[]
  kitItems            KitItem[]

  @@unique([tenantId, sku])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ─── CATEGORIA ────────────────────────────────────────────────────
model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, slug])
  @@map("categories")
}

// ─── MARCA ────────────────────────────────────────────────────────
model Brand {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  logo     String?
  isActive Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@map("brands")
}

// ─── KIT DE PRODUTOS ──────────────────────────────────────────────
model Kit {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  surface     String? // superfície alvo do kit
  totalPrice  Float
  discount    Float?  @default(0)
  isActive    Boolean @default(true)

  items KitItem[]

  @@map("kits")
}

model KitItem {
  id        String  @id @default(uuid())
  kitId     String
  productId String
  quantity  Float
  unit      String  @default("un")
  notes     String?

  kit     Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("kit_items")
}

// ─── PRODUTO RECOMENDADO NA CONVERSA ─────────────────────────────
model ConversationProduct {
  id             String  @id @default(uuid())
  conversationId String
  productId      String
  quantity       Float?
  unit           String?
  estimatedPrice Float?
  reason         String? // por que foi recomendado
  wasAccepted    Boolean?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@map("conversation_products")
}

// ─── CONFIGURAÇÃO DA IA ──────────────────────────────────────────
model AIConfig {
  id              String  @id @default(uuid())
  tenantId        String  @unique
  model           String  @default("gpt-4o")
  temperature     Float   @default(0.7)
  maxTokens       Int     @default(1000)
  topP            Float   @default(1.0)
  systemPrompt    String? // prompt principal do vendedor virtual
  welcomeMessage  String?
  transferMessage String? // mensagem ao transferir para humano
  isRAGEnabled    Boolean @default(true)
  isActive        Boolean @default(true)
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

// ─── PROMPT CONFIGURÁVEL ─────────────────────────────────────────
model Prompt {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  key         String  // identificador único do prompt
  content     String
  description String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("prompts")
}

// ─── INSTÂNCIA WHATSAPP ──────────────────────────────────────────
model WhatsAppInstance {
  id           String              @id @default(uuid())
  storeId      String
  instanceName String              @unique
  phone        String?
  status       WhatsAppStatus      @default(DISCONNECTED)
  qrCode       String?
  webhookUrl   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("whatsapp_instances")
}

// ─── ENUMS ────────────────────────────────────────────────────────

enum PlanType {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  STORE_MANAGER
  SELLER
}

enum ChannelType {
  WHATSAPP
  WEBCHAT
  TELEGRAM
}

enum ConversationStatus {
  BOT         // em atendimento pelo bot
  WAITING     // aguardando vendedor humano
  HUMAN       // em atendimento humano
  RESOLVED    // encerrada com sucesso
  ABANDONED   // cliente abandonou
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  SELLER
}

enum ContentType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  BUTTON
  LIST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum WhatsAppStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  BANNED
}
