{
  "version": 2,
  "name": "toque-de-cor-frontend",
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": {
      "description": "URL pública do backend (Railway). Ex: https://toque-de-cor-backend.up.railway.app"
    }
  }
}
