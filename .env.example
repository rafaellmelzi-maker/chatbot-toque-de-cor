# ─────────────────────────────────────────────────────────────────
# TOQUE DE COR – VARIÁVEIS DE AMBIENTE
# Copie este arquivo como .env e preencha os valores reais
# NUNCA commite o .env com segredos reais no repositório!
# ─────────────────────────────────────────────────────────────────

# ── Ambiente ──────────────────────────────────────────────────────
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=toquedecoradmin
POSTGRES_PASSWORD=TroquePorSenhaSegura123!
POSTGRES_DB=toque_de_cor
DATABASE_URL=postgresql://toquedecoradmin:TroquePorSenhaSegura123!@localhost:5432/toque_de_cor?schema=public

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=TroquePorSenhaRedisSegura123!
REDIS_URL=redis://:TroquePorSenhaRedisSegura123!@localhost:6379

# ── JWT (gere com: openssl rand -base64 64) ───────────────────────
JWT_SECRET=TROQUE_POR_SEGREDO_JWT_MUITO_LONGO_E_ALEATORIO_MINIMO_64_CHARS
JWT_REFRESH_SECRET=TROQUE_POR_SEGREDO_REFRESH_MUITO_LONGO_E_ALEATORIO
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-COLOQUE_SUA_CHAVE_OPENAI_AQUI
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# ── Evolution API (WhatsApp) ──────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=TROQUE_POR_CHAVE_EVOLUTION_SEGURA

# ── Webhook ───────────────────────────────────────────────────────
WEBHOOK_SECRET=TROQUE_POR_SEGREDO_WEBHOOK_ALEATORIO

# ── URLs ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# ── Upload de arquivos ────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logs ──────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Email (Nodemailer) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_app_gmail
EMAIL_FROM=Toque de Cor <seuemail@gmail.com>
